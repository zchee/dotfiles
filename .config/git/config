[core]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-corefileMode
	# Internal variable which enables various workarounds to enable Git to work better on filesystems that are not case sensitive, like APFS, HFS+, FAT, NTFS, etc.
	ignoreCase = true

	# Ensure that unicode filenames aren't mangled by HFS:
	# https://chromium.googlesource.com/chromium/src/+/master/docs/mac_build_instructions.md#Get-the-code
	precomposeUnicode = true
	fsmonitor = false
	editor = nvim

	# Treat spaces before tabs and all kinds of trailing whitespace as an error
	# default: trailing-space,space-before-tab 
	#  trailing-space: looks for spaces at the end of a line
	#  space-before-tab: looks for spaces before tabs at the beginning of a line
	whitespace = space-before-tab,-indent-with-non-tab,cr-at-eol

	# Make `git rebase` safer on OS X
	# More info: <http://www.git-tower.com/blog/make-git-rebase-safe-on-osx/>
	#  See also: <http://apple.stackexchange.com/a/52390/143973>
	trustctime = false

	quotepath = false
	symlinks = true
	autocrlf = false
	safecrlf = true
	repositoryFormatVersion = 1  # https://git-scm.com/docs/repository-version
	untrackedcache = true  # enabled by feature.manyFiles

[feature]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-feature
	experimental = false  # caused by init.defaultRefFormat=reftable
	manyFiles = true

[user]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-useremail
	email = zchee.io@gmail.com
	name = Koichi Shiraishi

[author]
	email = zchee.io@gmail.com
	name = Koichi Shiraishi

[committer]
	email = zchee.io@gmail.com
	name = Koichi Shiraishi

[gpg]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-gpgprogram
	program = gpg

[index]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-indexrecordEndOfIndexEntries
	threads = true
	skipHash = false
	# version = 4  # enabled by feature.manyFiles

[protocol]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-protocolallow
	allow = always
	version = 2

[pager]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-pagerltcmdgt
	log    = delta --true-color=always --hyperlinks --syntax-theme='Material-Theme' --pager='less -gij.1JMRSswX'  # --plus-color="#e6ffed" --minus-color="#340001"  # diff-highlight | less --tabs=4 -RFX
	show   = delta --true-color=always --hyperlinks --syntax-theme='Material-Theme' --pager='less -gij.1JMRSswX'  # --plus-color="#e6ffed" --minus-color="#340001"  # diff-highlight | less --tabs=4 -RFX
	diff   = delta --true-color=always --hyperlinks --syntax-theme='Material-Theme' --pager='less -gij.1JMRSswX'  # --diff-highlight --plus-color="#4a704b" --minus-color="#5e3333"  # diff-highlight | less --tabs=4 -RFX
	blame  = delta --true-color=always --hyperlinks --syntax-theme='Material-Theme' --pager='less -gij.1JMRSswX'
	# diff   = git-split-diffs --color | less -+LFX
	# log    = diff-highlight | less --tabs=4 -RFX
	# show   = diff-highlight | less --tabs=4 -RFX
	# diff   = diff-highlight | less --tabs=4 -RFX
	branch = false
	config = false
	tag    = false

[delta]
	syntax-theme = Material-Theme-Darker
	true-color = always
	side-by-side = false

[split-diffs]
	syntax-highlighting-theme = github-dark
	theme-name = github-dark-dim

[color]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-color
	# color:      normal, black, red, green, yellow, blue, magenta, cyan, white, #RGB
	# attributes: bold, dim, ul, blink, reverse, italic, strike
	ui = auto
	diff = auto
	status = auto
	branch = auto
	blame  = auto
[color "branch"]
	current = yellow bold reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold # line info
	old = red # deletions
	new = green # additions
[color "status"]
	added = yellow
	changed = green
	header = bold
	nobranch = bold
	unmerged = reverse
	untracked = cyan
	updated = yellow
[color "blame"]
	highlightRecent = \
		234, 23 month ago, \
		235, 22 month ago, \
		236, 21 month ago, \
		237, 20 month ago, \
		238, 19 month ago, \
		239, 18 month ago, \
		240, 17 month ago, \
		241, 16 month ago, \
		242, 15 month ago, \
		243, 14 month ago, \
		244, 13 month ago, \
		245, 12 month ago, \
		246, 11 month ago, \
		247, 10 month ago, \
		248,  9 month ago, \
		249,  8 month ago, \
		250,  7 month ago, \
		251,  6 month ago, \
		252,  5 month ago, \
		253,  4 month ago, \
		254,  3 month ago, \
		231,  2 month ago, \
		230,  1 month ago, \
		229,  3 weeks ago, \
		228,  2 weeks ago, \
		227,   1 week ago, \
		226

[i18n]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-i18ncommitEncoding
	commitEncoding = utf-8
	logOutputEncoding = utf-8

[init]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-inittemplateDir
	defaultBranch = main
	defaultRefFormat = files
	# TODO(zchee): conflicted of git-codereview, should change the hook scripts behavior
	templateDir = /Users/zchee/src/github.com/zchee/dotfiles/.config/git/templates

[pack]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-packwindow
	thread = 0
	useSparse = true
	useBitmapBoundaryTraversal = true  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-featureexperimental
	allowPackReuse = multi  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-featureexperimental
	usePathWalk = true  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-featureexperimental

[add "interactive"]
	useBuiltin = true

[pull]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-pullff
	ff = only
	twohead = ort

[blame]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-blameblankBoundary
	coloring = highlightRecent
	date = human

[apply]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-applyignoreWhitespace
	# Detect whitespace errors when applying a patch
	whitespace = nowarn

[branch]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-branchautoSetupMerge
	sort = refname

[gc]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-gcaggressiveDepth
	writeCommitGraph = true
	cruftPacks = true
	pruneExpire = 1.day.ago

[tag]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-tagforceSignAnnotated
	gpgSign = true
	forceSignAnnotated = true
	sort = version:refname

[merge] #  https://git-scm.com/docs/git-config#Documentation/git-config.txt-mergeconflictStyle
	# Include summaries of merged commits in newly created merge commit messages
	log = false
	conflictstyle = zdiff3
	gpgSign = true

[submodule]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-submoduleltnamegturl
	fetchJobs = 32

[subtree]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-submoduleltnamegturl
	fetchJobs = 32

[fetch]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-fetchrecurseSubmodules
	recurseSubmodules = false
	writeCommitGraph = true
	showForcedUpdates = true
	negotiationAlgorithm = skipping  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-featureexperimental

[commit]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-commitcleanup
	# GPG-signed and Sign off the Developer Certificate of Origin <http://developercertificate.org>
	# See also: <http://gerrit.googlecode.com/svn/documentation/2.0/user-signedoffby.html>
	#           <http://stackoverflow.com/a/1962112/5228839>
	gpgSign = true
	verbose = true

[revert]
	gpgSign = true

[push]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-pushdefault
	# Use the Git 1.x.x default to avoid errors on machines with old Git
	# installations. To use `simple` instead, add this to your `~/.extra` file:
	# `git config --global push.default simple`. See http://git.io/mMah-w.
	# default = matching
	default = current

[rebase]  # https://git-scm.com/docs/git-rebase#_configuration
	autosquash = true
	autostash = true
	verbose = true
	abbreviateCommands = true

[difftool]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-difftoollttoolgtpath
	prompt = false
	trustExitCode = true
[difftool "nvim_difftool"]
	cmd = nvim -c \"packadd nvim.difftool\" -c \"DiffTool $LOCAL $REMOTE\"

[diff]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-diffautoRefreshIndex
	tool = nvim_difftool
	colorMoved = default  # Blocks of moved text are detected as in blocks mode.
	compactionHeuristic = true
	prompt = true
	renames = copies  # Whether and how Git detects renames. If set to "false", rename detection is disabled. If set to "true", basic rename detection is enabled. If set to "copies" or "copy", Git will detect copies, as well.
[diff "sopsdiffer"]
	textconv = sops -d
[diff "ansible-vault-differ"]
	textconv = ansible-vault view

[interactive]
	diffFilter = delta --color-only

# If you want to set up Kaleidoscope as the default merge tool,
# then also set the following variables:
[mergetool]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-mergetoollttoolgtpath
	prompt = true

[lfs "https://go.googlesource.com/go.git/info/lfs"]
	locksverify = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[credential]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-credentialhelper
	helper = osxkeychain
	useHttpPath = false
[credential "https://github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://source.developers.google.com"]
	helper = gcloud.sh
[credential "https://chromium.googlesource.com/infra/goma/server.git"]
	provider = generic
[credential "https://git.code.sf.net/p/sshpass/code-git.git"]
	provider = generic
[credential "https://dev.azure.com"]
	useHttpPath = true

[completion]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-completioncommands: separated by space
	commands = see goget parallel-fetch lfs

# [completion]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-completioncommands: separated by space
# 	commands = blame-pr blamec blamec-ruby chglog clang-format cliff cliff-completions codereview compare cueget cvsserver delete-merged filter-repo gen generate-changelog goget goget  gud home hyper-blame lfs list-gitignore map map-branches open parallel-fetch parallel-fetch receive-pack remote-keybase restore-branch see shell split-diffs upload-archive upload-pack xargs ydiff

[help]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-helpbrowser
	# Disable correct and execute mistyped commands
	autocorrect = 0

[advice]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-advice
	waitingforeditor = false  # ignore "hint: Waiting for your editor to close the file..." message
	detachedHead = false
	skippedCherryPicks = false

[http]  # https://git-scm.com/docs/git-config#Documentation/git-config.txt-httpproxy
	cookiefile = /Users/zchee/src/github.com/zchee/dotfiles/.config/git/cookies
	saveCookies = true
	maxRequests = 20
	postBuffer = 157286400
[http "https://gopkg.in"]
	followRedirects = true

## https://git-scm.com/docs/git-config#Documentation/git-config.txt-urlltbasegtinsteadOf
