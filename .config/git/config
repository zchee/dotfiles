	insteadOf = "https://gitlab.com/zchee"
	pushInsteadOf = "git://gitlab.com/zchee"

[maintenance]
	strategy = incremental

[maintenance "commit-graph"]
	auto = 500

[include]  # https://git-scm.com/docs/git-config#_includes
	path = config.alias
	path = config.d/orgs
	path = config.d/private

## github.com/x-motemen/ghq
[ghq]
	root = ~/go/src
	root = ~/src

## https://github.com/coderabbitai/git-worktree-runner
[gtr "editor"]
	default = nvim
[gtr "ai"]
	default = codex --yolo
