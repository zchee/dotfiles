<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.xml">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>io.containerd.containerd</string>
    <key>Umask</key>
    <integer>0002</integer>
    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/bin/containerd</string>
      <string>-c</string>
      <string>/etc/containerd/config.toml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/opt/local/containerd:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/var/log/containerd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/containerd.errors.log</string>
  </dict>
</plist>
