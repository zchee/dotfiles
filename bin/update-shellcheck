#!/usr/bin/env bash
set -euo pipefail
# shellcheck shell=bash

info() { printf "\\x1b[1;34m[INFO]\\x1b[0m %s\\n\\n" "$1"; }

BIN="${0##*-}"
SHELLCHECK_PATH="${SHELLCHECK_PATH:-/opt/local/bin/shellcheck}"

info "Current $BIN version:
$($BIN --version)"

PATTERN="$(uname -sm | tr ' ' '.' | tr '[:upper:]' '[:lower:]' | sed 's|arm64|aarch64|')"

DOWNLOAD_DIR=$(mktemp -d)
pushd "${DOWNLOAD_DIR}" >/dev/null 2>&1

curl -sSLO "https://github.com/koalaman/shellcheck/releases/download/latest/shellcheck-latest.${PATTERN}.tar.xz"
tar xf "shellcheck-latest.${PATTERN}.tar.xz"
mv -f "shellcheck-latest/shellcheck" "${SHELLCHECK_PATH}"

popd >/dev/null 2>&1
rm -rf "${DOWNLOAD_DIR}"

${SHELLCHECK_PATH} --version
